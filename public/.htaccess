<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Direktori unggahan tidak pernah melayani berkas yang bisa dieksekusi.
    #
    # storage/app/public/.htaccess sudah melepas handler PHP di direktorinya
    # sendiri, tetapi berkas itu hanya terbaca bila AllowOverride aktif untuk
    # path tersebut — pada banyak hosting, override hanya diizinkan di docroot.
    # Aturan berikut berjalan dari docroot, sehingga tetap berlaku walau
    # .htaccess di dalam direktori unggahan diabaikan server.
    RewriteRule ^storage/.*\.(?:php|phar|phtml|pht|php[0-9]|cgi|pl|py|rb|sh|asp|aspx|jsp|htaccess|htpasswd)$ - [F,L,NC]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Kompres respons teks jika modul server tersedia.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Asset hasil build dan upload memakai nama unik, sehingga aman di-cache lama.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(build|storage)/" immutable_asset=1
</IfModule>

<IfModule mod_headers.c>
    Header append Vary Accept-Encoding
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"

    <FilesMatch "\.(?:css|js|woff2?|png|jpe?g|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
</IfModule>
